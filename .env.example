# App
NODE_ID=1
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://port:port_local_password@localhost:5432/port?sslmode=disable

# Cache
REDIS_URL=redis://localhost:16379

# Media server registration. Set to the URL port-api can call inside Docker.
MEDIA_SERVER_URL=http://port-media:8080
MEDIA_SERVER_MAX_SESSIONS=0

# Realtime session behavior.
REALTIME_STUN_URLS=stun:stun.l.google.com:19302
