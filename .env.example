# App
NODE_ID=1
SERVER_PORT=8080
LOG_LEVEL=info

# OpenAI Realtime.
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Database
DATABASE_URL=file:portfoilo_media.db?cache=shared

# Cache
REDIS_URL=redis://localhost:6379

# Media server registration. Set to the URL port-api can call inside Docker.
MEDIA_SERVER_URL=http://port-media:8080

# Optional deployment overrides.
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# MEDIA_SERVER_MAX_SESSIONS=0
# REALTIME_STUN_URLS=stun:stun.l.google.com:19302
# OPENAI_REALTIME_MODEL=gpt-realtime-2
