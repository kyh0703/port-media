# Config profile. The app reads <APP_PROFILE>.yaml and defaults to dev.
APP_PROFILE=dev

# Required node identity for heartbeat/state reporting.
NODE_ID=media-node-local

# OpenAI Realtime.
OPENAI_API_KEY=sk-replace-with-openai-api-key
OPENAI_REALTIME_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_DATA_CHANNEL_LABEL=oai-events

# HTTP server.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Runtime dependencies.
DATABASE_DSN=file:portfoilo_media.db?cache=shared
DATABASE_BUSY_TIMEOUT=5s
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
REDIS_URL=redis://localhost:6379

# Media server registration and heartbeat.
MEDIA_SERVER_URL=http://localhost:8080
MEDIA_SERVER_STATUS=healthy
MEDIA_SERVER_HEARTBEAT_ENABLED=true
MEDIA_SERVER_HEARTBEAT_INTERVAL=10s
MEDIA_SERVER_HEARTBEAT_TTL=30s
MEDIA_SERVER_MAX_SESSIONS=0

# Redis event stream.
EVENTS_CONVERSATION_STREAM_ENABLED=true
EVENTS_CONVERSATION_STREAM_NAME=media:conversation-events:v1
EVENTS_CONVERSATION_STREAM_MAX_LEN=0

# Realtime session behavior.
REALTIME_ROOM_IDLE_TIMEOUT=2m
REALTIME_ICE_GATHERING_TIMEOUT=5s
REALTIME_EVENT_HISTORY_LIMIT=10

# Logging.
LOG_LEVEL=debug
LOG_DEVELOPMENT=true
