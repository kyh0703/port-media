# Required node identity for heartbeat/state reporting.
NODE_ID=1

# OpenAI Realtime.
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Runtime dependencies. Defaults are local SQLite and local Redis.
# DATABASE_DSN=file:portfoilo_media.db?cache=shared
# DATABASE_BUSY_TIMEOUT=5s
# DATABASE_MAX_OPEN_CONNS=10
# DATABASE_MAX_IDLE_CONNS=5
REDIS_URL=redis://localhost:6379

# Optional Docker/deployment overrides.
# SERVER_PORT=8080
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# MEDIA_SERVER_URL=https://media.example.com
# MEDIA_SERVER_MAX_SESSIONS=0
# REALTIME_STUN_URLS=stun:stun.l.google.com:19302
# OPENAI_REALTIME_MODEL=gpt-realtime-2

# Logging.
# LOG_LEVEL=info
# LOG_DEVELOPMENT=false
